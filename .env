# Build-time ad flags (committed on purpose — non-secret PUBLIC_* switches).
# Astro inlines PUBLIC_* into import.meta.env at build; this file is how the
# Cloudflare Git-integration build gets them (old Builds API can't set env).
PUBLIC_ADSTERRA_SLOT_INCONTENT_300X250=1
PUBLIC_SOCIAL_BAR_URL=https://bauval.org/14/bdef883e14ae417d43650ffe63144ba0
